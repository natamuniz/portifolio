---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projetos = (await getCollection('projetos')).sort(
    (a, b) => Number(b.data.destaque) - Number(a.data.destaque) || a.data.ordem - b.data.ordem || b.data.ano - a.data.ano,
  );
  return projetos.map((projeto, i) => ({
    params: { slug: projeto.id },
    props: { projeto, anterior: projetos[i - 1], proximo: projetos[i + 1] },
  }));
}

const { projeto, anterior, proximo } = Astro.props;
const d = projeto.data;
const { Content } = await render(projeto);
const temCorpo = Boolean(projeto.body?.trim());
---
<Base title={`${d.titulo} · ${d.codigo} · Natã Muniz`} description={d.resumo}>
  <article class="wrap prj">
    <a href="/#projetos" class="mono prj__voltar">← arquivo de projetos</a>

    <header class="prj__head">
      <p class="eyebrow">{d.codigo} · {d.ano} · {d.tipo}</p>
      <h1 class="prj__titulo">{d.titulo}</h1>
      <p class="prj__resumo">{d.resumo}</p>
      <div class="prj__ctas">
        {d.link && <a href={d.link} target="_blank" rel="noopener" class="btn btn--primary">Ver ao vivo ↗</a>}
        {d.repositorio && <a href={d.repositorio} target="_blank" rel="noopener" class="btn">Código no GitHub ↗</a>}
      </div>
    </header>

    <dl class="ficha mono">
      <div><dt>Código</dt><dd>{d.codigo}</dd></div>
      <div><dt>Ano</dt><dd>{d.ano}</dd></div>
      <div><dt>Tipo</dt><dd>{d.tipo}</dd></div>
      {d.papel && <div class="ficha__papel"><dt>Papel</dt><dd>{d.papel}</dd></div>}
      {d.stack.length > 0 && <div class="ficha__stack"><dt>Stack</dt><dd>{d.stack.map((s) => <span class="tag">{s}</span>)}</dd></div>}
    </dl>

    {d.capa && (
      <figure class="prj__capa">
        <Image src={d.capa} alt={d.capaAlt ?? d.titulo} widths={[800, 1440]} sizes="(max-width: 1240px) 100vw, 1192px" loading="eager" />
      </figure>
    )}
    {!d.capa && d.previa && <pre class="prj__previa mono">{d.previa}</pre>}

    {temCorpo && <div class="prose"><Content /></div>}

    {d.galeria.length > 0 && (
      <div class="prj__galeria">
        {d.galeria.map((g) => (
          <figure>
            <Image src={g.src} alt={g.alt} widths={[400, 800]} sizes="(max-width: 700px) 100vw, 400px" />
            <figcaption class="mono">{g.alt}</figcaption>
          </figure>
        ))}
      </div>
    )}

    <nav class="prj__nav mono" aria-label="Outros projetos">
      {anterior ? <a href={`/projetos/${anterior.id}/`}>← {anterior.data.codigo} {anterior.data.titulo}</a> : <span></span>}
      {proximo && <a href={`/projetos/${proximo.id}/`}>{proximo.data.codigo} {proximo.data.titulo} →</a>}
    </nav>
  </article>
</Base>

<style>
  .prj { padding-top: 48px; padding-bottom: 96px; }
  .prj__voltar { font-size: 13px; color: var(--dim); }
  .prj__voltar:hover { color: var(--accent); }
  .prj__head { display: flex; flex-direction: column; gap: 18px; margin: 40px 0 32px; max-width: 820px; }
  .prj__titulo { margin: 0; font-size: clamp(44px, 7vw, 88px); line-height: 0.95; font-weight: 900; font-stretch: 112%; text-transform: uppercase; letter-spacing: -0.02em; }
  .prj__resumo { margin: 0; font-size: 19px; line-height: 1.6; color: var(--muted); }
  .prj__ctas { display: flex; flex-wrap: wrap; gap: 12px; padding-top: 6px; }

  .ficha { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); margin: 0 0 40px; border: 1px solid #1f231e; border-radius: 10px; overflow: hidden; }
  .ficha > div { padding: 16px 18px; border-right: 1px dashed #2a2f27; border-bottom: 1px dashed #2a2f27; }
  .ficha__stack { grid-column: 1 / -1; }
  .ficha__papel { grid-column: span 2; }
  @media (max-width: 520px) { .ficha__papel { grid-column: 1 / -1; } }
  .ficha dt { font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--dim); margin-bottom: 6px; }
  .ficha dd { margin: 0; font-size: 14px; display: flex; flex-wrap: wrap; gap: 8px; }

  .prj__capa { margin: 0 0 48px; border: 1px solid var(--line-2); border-radius: 12px; overflow: hidden; }
  .prj__previa { margin: 0 0 48px; padding: 28px; background: var(--panel); border: 1px solid var(--line-2); border-radius: 12px; font-size: 14px; line-height: 1.7; color: var(--text-2); overflow-x: auto; }

  .prose { max-width: 760px; font-size: 17px; line-height: 1.75; color: var(--text-2); }
  .prose :global(h2) { margin: 48px 0 16px; font-family: var(--mono); font-size: 14px; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent); }
  .prose :global(h2)::before { content: '## '; color: var(--dim); }
  .prose :global(ul) { padding-left: 20px; }
  .prose :global(li) { margin: 8px 0; }
  .prose :global(li::marker) { color: var(--accent); }
  .prose :global(strong) { color: var(--text); }
  .prose :global(code) { font-family: var(--mono); font-size: 0.88em; padding: 2px 6px; background: var(--panel); border: 1px solid var(--line-2); border-radius: 4px; }
  .prose :global(blockquote) { margin: 32px 0; padding: 12px 18px; border: 1px dashed var(--line-3); border-radius: 8px; color: var(--dim); font-family: var(--mono); font-size: 13px; }
  .prose :global(blockquote p) { margin: 0; }

  .prj__galeria { display: flex; flex-wrap: wrap; gap: 20px; margin-top: 48px; }
  .prj__galeria figure { margin: 0; flex: 0 1 320px; }
  .prj__galeria img { border: 1px solid var(--line-2); border-radius: 12px; }
  .prj__galeria figcaption { margin-top: 10px; font-size: 12px; color: var(--dim); }

  .prj__nav { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 16px; margin-top: 72px; padding-top: 24px; border-top: 1px solid var(--line); font-size: 14px; }
  .prj__nav a:hover { color: var(--accent); }
</style>
