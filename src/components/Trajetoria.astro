---
import { trajetoria, formacao } from '../data/perfil';
---
<section id="trajetoria" class="wrap section">
  <p class="eyebrow">Trajetória</p>
  <h2 class="mono traj__cmd">$ git log --oneline natã</h2>
  <ol class="traj">
    {trajetoria.map((c, i) => (
      <li>
        <div class="traj__meta mono">
          <span class:list={['traj__dot', { 'is-head': i === 0 }]} aria-hidden="true"></span>
          <span class="accent">{c.hash}</span>
          <span class="dim">{c.ano}</span>
        </div>
        <div class="traj__msg mono">{c.mensagem}{i === 0 && <span class="traj__head"> (HEAD)</span>}</div>
        <div class="traj__desc">{c.descricao}</div>
      </li>
    ))}
  </ol>

  <h3 class="mono traj__cmd traj__cmd--sub">$ cat formacao.txt</h3>
  <ul class="form">
    {formacao.map((f) => (
      <li class="card form__item">
        <span class:list={['form__status', 'mono', { 'is-on': f.status === 'cursando' }]}>{f.status}</span>
        <h4>{f.curso}</h4>
        <p class="mono">{f.instituicao}</p>
      </li>
    ))}
  </ul>
</section>
<style>
  .traj__cmd { margin: 10px 0 24px; font-size: clamp(22px, 2.6vw, 30px); font-weight: 500; }
  .traj { list-style: none; margin: 0; padding: 0; position: relative; }
  .traj li { display: flex; flex-wrap: wrap; gap: 8px 28px; align-items: flex-start; padding: 18px 0; border-bottom: 1px solid #1a1d19; }
  .traj__meta { display: flex; align-items: center; gap: 16px; width: 170px; flex: none; font-size: 13px; }
  .dim { color: var(--dim); }
  .traj__dot { width: 12px; height: 12px; border-radius: 50%; border: 2px solid var(--accent); background: var(--bg); flex: none; }
  .traj__dot.is-head { background: var(--accent); box-shadow: 0 0 12px var(--accent); }
  .traj__msg { flex: 1 1 260px; min-width: 0; font-size: 15px; }
  .traj__head { color: var(--accent); }
  .traj__desc { flex: 1 1 320px; min-width: 0; font-size: 14px; line-height: 1.6; color: var(--muted); }
  .traj__cmd--sub { margin-top: 56px; font-size: clamp(18px, 2vw, 22px); }
  .form { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; }
  .form__item { padding: 22px 22px 20px; display: flex; flex-direction: column; gap: 8px; }
  .form__item:hover { transform: none; }
  .form__item h4 { margin: 0; font-size: 19px; font-weight: 600; }
  .form__item p { margin: 0; font-size: 13px; color: var(--dim); }
  .form__status { align-self: flex-start; padding: 3px 8px; border: 1px solid var(--line-3); border-radius: 3px; font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); }
  .form__status.is-on { border-color: var(--accent); color: var(--accent); }
</style>
