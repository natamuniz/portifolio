---
import { getCollection } from 'astro:content';
import { perfil } from '../data/perfil';
import Globe from './Globe.astro';

const projetos = (await getCollection('projetos', (p) => p.data.destaque)).sort((a, b) => a.data.ordem - b.data.ordem);
const principal = projetos[0];
const pastas = projetos.map((p) => `${p.data.codigo}_${p.id}/`);
const proximo = `PRJ-${String(projetos.length + 1).padStart(3, '0')}_[aguardando-captura]/`;
---
<section id="inicio" class="wrap hero">
  <div class="hero__text">
    <p class="mono accent hero__hello">&lt; Olá, eu sou /&gt;</p>
    <h1 class="hero__name">{perfil.nome}<br /><span class="accent">{perfil.sobrenome}</span></h1>
    <p class="mono hero__role">{perfil.cargo}</p>
    <p class="hero__lead">{perfil.chamada}</p>
    <div class="hero__ctas">
      <a href="#projetos" class="btn btn--primary">Ver projetos →</a>
      {perfil.curriculo
        ? <a href={perfil.curriculo} class="btn" download="Curriculo-Nata-Muniz.pdf">Baixar currículo ↓</a>
        : <a href={perfil.linkedin} class="btn" target="_blank" rel="noopener">Meu LinkedIn ↗</a>}
    </div>
    <p class="mono hero__avail">{perfil.disponibilidade}</p>
  </div>

  <div class="hero__visual">
    <Globe />
    <div class="term">
      <div class="term__bar">
        <div class="term__dots" aria-hidden="true"><span></span><span></span><span></span></div>
        <span class="mono">nata@rio:~/portfolio</span>
        <span class="term__led" aria-hidden="true"></span>
      </div>
      <div class="term__body mono">
        <span class="l"><span class="accent">$</span> ls projetos/</span>
        <span class="l term__ls">{pastas.map((p) => <span>{p}</span>)}<span class="dim">{proximo}</span></span>
        <span class="l">&nbsp;</span>
        {principal && (
          <Fragment>
            <span class="l"><span class="accent">$</span> cat {principal.data.codigo}_{principal.id}/ficha.yml</span>
            <span class="l"><span class="dim">tipo:   </span> API de gestão documental</span>
            <span class="l"><span class="dim">stack:  </span> [{principal.data.stack.slice(0, 3).join(', ')}]</span>
            <span class="l"><span class="dim">regras: </span> temporalidade, sigilo, auditoria</span>
            <span class="l"><span class="dim">fixidez:</span> sha256 <span class="accent">✓ íntegro</span></span>
            <span class="l">&nbsp;</span>
          </Fragment>
        )}
        <span class="l"><span class="accent">$</span> <span class="term__caret cursor"></span></span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero { display: flex; flex-wrap: wrap; gap: 48px; align-items: center; padding-top: 96px; padding-bottom: 88px; }
  .hero__text { flex: 1 1 460px; min-width: 0; display: flex; flex-direction: column; gap: 24px; }
  .hero__hello { margin: 0; font-size: 16px; }
  .hero__name {
    margin: 0; font-size: clamp(56px, 8vw, 104px); line-height: 0.92; font-weight: 900;
    font-stretch: 112%; letter-spacing: -0.02em; text-transform: uppercase;
  }
  .hero__role { margin: 0; font-size: 15px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-2); }
  .hero__lead { margin: 0; max-width: 520px; font-size: 18px; line-height: 1.6; color: var(--muted); }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: 14px; padding-top: 8px; }
  .hero__avail { margin: 0; font-size: 13px; color: var(--dim); }

  .hero__visual { flex: 1 1 520px; min-width: 0; position: relative; min-height: 440px; display: flex; align-items: center; }
  .term {
    position: relative; width: 100%; max-width: 560px; background: rgba(17, 19, 17, 0.92);
    border: 1px solid var(--line-2); border-radius: 12px; box-shadow: 0 24px 80px rgba(0, 0, 0, 0.6); overflow: hidden;
  }
  .term__bar { display: flex; align-items: center; justify-content: space-between; padding: 12px 16px; border-bottom: 1px solid #1f231e; font-size: 12px; color: var(--dim); }
  .term__dots { display: flex; gap: 8px; }
  .term__dots span { width: 11px; height: 11px; border-radius: 50%; background: #3a4236; }
  .term__led { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 10px var(--accent); }
  .term__body { padding: 22px 22px 26px; font-size: 14px; line-height: 1.75; color: var(--text-2); overflow-x: auto; }
  .term__body .l { display: block; white-space: pre-wrap; }
  .term__body .term__ls { display: flex; flex-wrap: wrap; gap: 0 20px; color: var(--text); }
  .dim { color: var(--dim); }
  .term__caret { display: inline-block; width: 9px; height: 17px; background: var(--accent); vertical-align: -3px; }

  /* As linhas do terminal aparecem uma a uma */
  .l { opacity: 0; animation: line-in .01s forwards; }
  .l:nth-child(1) { animation-delay: .2s; }
  .l:nth-child(2) { animation-delay: .5s; }
  .l:nth-child(3) { animation-delay: .7s; }
  .l:nth-child(4) { animation-delay: 1.1s; }
  .l:nth-child(5) { animation-delay: 1.35s; }
  .l:nth-child(6) { animation-delay: 1.5s; }
  .l:nth-child(7) { animation-delay: 1.65s; }
  .l:nth-child(8) { animation-delay: 1.8s; }
  .l:nth-child(9) { animation-delay: 1.9s; }
  .l:nth-child(10) { animation-delay: 2.1s; }
  @keyframes line-in { to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .l { opacity: 1; } }

  @media (max-width: 700px) {
    .hero { padding-top: 56px; padding-bottom: 56px; }
    .hero__visual { min-height: 0; }
    .term__body { font-size: 12.5px; padding: 18px; }
  }
</style>
