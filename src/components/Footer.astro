---
import { perfil } from '../data/perfil';
const ano = new Date().getFullYear();
const atualizado = new Date().toLocaleDateString('pt-BR');
---
<footer class="foot">
  <div class="wrap foot__in mono">
    <span><span class="accent foot__logo">{perfil.iniciais}_</span> © {ano} {perfil.nome} {perfil.sobrenome}</span>
    <span>Feito no Rio · registro atualizado em {atualizado}</span>
    <div class="foot__links">
      <a class="icon-btn" href={perfil.github} target="_blank" rel="noopener" aria-label="GitHub">gh</a>
      <a class="icon-btn" href={perfil.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn">in</a>
      <a class="icon-btn" href="#conteudo" aria-label="Voltar ao topo">↑</a>
    </div>
  </div>
</footer>
<style>
  .foot { border-top: 1px solid var(--line); }
  .foot__in { display: flex; flex-wrap: wrap; gap: 16px; justify-content: space-between; align-items: center; padding-top: 24px; padding-bottom: 24px; font-size: 12px; color: var(--dim); }
  .foot__logo { font-weight: 700; margin-right: 8px; }
  .foot__links { display: flex; gap: 8px; }
</style>
