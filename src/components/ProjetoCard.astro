---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props { projeto: CollectionEntry<'projetos'> }
const { projeto } = Astro.props;
const d = projeto.data;
const url = `/projetos/${projeto.id}/`;
---
<article class="card pcard">
  <div class="pcard__head mono">
    <span>{d.codigo} · {d.ano} · {d.tipo.toUpperCase()}</span>
    {d.selo && <span class="pcard__selo">{d.selo.toUpperCase()}</span>}
  </div>
  <a href={url} class="pcard__media" tabindex="-1" aria-hidden="true">
    {d.capa
      ? <Image src={d.capa} alt="" widths={[400, 800]} sizes="(max-width: 700px) 100vw, 400px" />
      : <pre class="mono">{d.previa}</pre>}
  </a>
  <div class="pcard__body">
    <h3><a href={url} class="pcard__link">{d.titulo}</a></h3>
    <p>{d.resumo}</p>
    <div class="pcard__tags">{d.stack.slice(0, 4).map((s) => <span class="tag">{s}</span>)}</div>
    <div class="pcard__foot">
      <span class="mono">{(d.link ?? d.repositorio ?? '').replace(/^https?:\/\//, '').replace(/\/$/, '')}</span>
      <span class="icon-btn" aria-hidden="true">↗</span>
    </div>
  </div>
</article>
<style>
  .pcard { position: relative; overflow: hidden; display: flex; flex-direction: column; }
  .pcard__head { display: flex; justify-content: space-between; align-items: center; padding: 12px 16px; border-bottom: 1px dashed #2a2f27; font-size: 12px; color: var(--dim); }
  .pcard__selo { padding: 3px 8px; background: var(--accent); color: var(--on-accent); border-radius: 3px; font-weight: 700; font-size: 11px; }
  .pcard__media { display: block; height: 210px; background: var(--bg-2); border-bottom: 1px solid #1f231e; overflow: hidden; }
  .pcard__media img { width: 100%; height: 100%; object-fit: cover; object-position: top; transition: transform .4s; }
  .pcard:hover .pcard__media img { transform: scale(1.03); }
  .pcard__media pre { margin: 0; padding: 18px; font-size: 12px; line-height: 1.6; color: var(--muted); white-space: pre; overflow: hidden; }
  .pcard__body { padding: 20px; display: flex; flex-direction: column; gap: 12px; flex: 1; }
  .pcard__body h3 { margin: 0; font-size: 22px; font-weight: 700; }
  /* O link do título cobre o card inteiro */
  .pcard__link::after { content: ''; position: absolute; inset: 0; }
  .pcard__body p { margin: 0; font-size: 14px; line-height: 1.6; color: var(--muted); }
  .pcard__tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: auto; padding-top: 8px; }
  .pcard__foot { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding-top: 12px; border-top: 1px solid #1f231e; }
  .pcard__foot .mono { font-size: 11px; color: var(--dim); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .pcard:hover .icon-btn { border-color: var(--accent); }
</style>
