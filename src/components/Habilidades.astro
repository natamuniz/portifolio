---
import { habilidades } from '../data/perfil';
---
<section id="habilidades" class="wrap section">
  <p class="eyebrow">Habilidades &amp; serviços</p>
  <ul class="skills">
    {habilidades.map((h) => (
      <li class="card skill">
        <span class="skill__icon mono" aria-hidden="true">{h.icone}</span>
        <h3>{h.titulo}</h3>
        <p>{h.texto}</p>
      </li>
    ))}
  </ul>
</section>
<style>
  .skills { list-style: none; margin: 32px 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px; }
  .skill { border-radius: 10px; padding: 24px 20px; display: flex; flex-direction: column; gap: 14px; }
  .skill__icon { font-size: 20px; color: var(--accent); }
  .skill h3 { margin: 0; font-size: 17px; font-weight: 600; }
  .skill p { margin: 0; font-size: 14px; line-height: 1.55; color: var(--muted); }
</style>
